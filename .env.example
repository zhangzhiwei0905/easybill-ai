# ============================================================
# EasyBill AI - 环境变量配置
# 本地开发和服务器部署共用此文件结构
# 复制为 .env 并填入实际值: cp .env.example .env
# ============================================================

# ---- Database ----
# 本地开发: postgresql://easybill:密码@localhost:5432/easybill
# Docker 部署: postgresql://easybill:密码@postgres:5432/easybill
DATABASE_URL="postgresql://easybill:your-password@localhost:5432/easybill"
DATABASE_SSL=false

# Docker Compose 专用（仅部署时使用）
POSTGRES_USER=easybill
POSTGRES_PASSWORD=your-password
POSTGRES_DB=easybill

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ---- App ----
PORT=3000
NODE_ENV=development

# ---- Frontend ----
# 本地开发留空（vite proxy 自动代理 /api）
# Docker 部署留空（nginx 代理）
# 独立部署前端时填后端地址，如 https://api.your-domain.com
VITE_API_URL=
FRONTEND_URL=http://localhost:8081
FRONTEND_PORT=8081

# ---- Email (验证码) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ---- AI ----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ---- Google OAuth (可选) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- WeChat OAuth (可选) ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:3000/api/auth/wechat/callback

# ---- Aliyun OSS (头像存储) ----
OSS_REGION=oss-cn-shenzhen
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=easybill-avatars
OSS_AVATAR_PREFIX=avatars/

# ---- File Upload ----
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ---- Webhook ----
WEBHOOK_API_KEY=your-webhook-api-key
