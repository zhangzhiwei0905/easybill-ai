# ============================================
# EasyBill AI Production Environment
# ============================================
# Copy this file to .env.production and fill in real values.
# Generate secrets with: openssl rand -base64 48

# ----- PostgreSQL -----
POSTGRES_USER=easybill
POSTGRES_PASSWORD=<change-me-to-a-strong-password>
POSTGRES_DB=easybill
DATABASE_URL=postgresql://easybill:<change-me>@postgres:5432/easybill
DATABASE_SSL=false

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379

# ----- JWT -----
# Generate with: openssl rand -base64 48
JWT_SECRET=<generate-a-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=<generate-another-secret>
JWT_REFRESH_EXPIRES_IN=30d

# ----- Application -----
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-domain.com
# Port exposed on host (default: 80)
FRONTEND_PORT=80

# ----- DeepSeek AI API -----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# ----- Email SMTP (Gmail) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ----- Google OAuth (optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# ----- WeChat OAuth (optional) -----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=https://your-domain.com/api/auth/wechat/callback

# ----- File Upload -----
MAX_FILE_SIZE=5242880

# ----- Webhook -----
WEBHOOK_API_KEY=<generate-with-openssl-rand-hex-32>
